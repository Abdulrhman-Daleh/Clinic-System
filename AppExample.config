<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<!--Enter you're personal information-->
	<connectionStrings>
		<add name="DBConnection"
			 connectionString="Server=YOUR-SERVER;Database=ClinicDatabase;Username=YOUR-USERNAME;Password=YOUR-PASSWORD;"/>
	</connectionStrings>
</configuration>